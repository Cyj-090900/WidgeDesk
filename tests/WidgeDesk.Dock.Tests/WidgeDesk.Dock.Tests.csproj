<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the dock window shell: window-style contracts (WS_EX_NOACTIVATE) and the
    dock settings notification pipe. Separate from WidgeDesk.Core.Tests because these
    create real WPF windows and read real window styles, so they need net10.0-windows
    and an STA thread; separate from WidgeDesk.AppServices.Tests because they exercise
    the presentation layer, not the application services.

    Package versions are pinned centrally in Directory.Packages.props.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>WidgeDesk.Dock.Tests</RootNamespace>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WidgeDesk.Dock\WidgeDesk.Dock.csproj" />
    <ProjectReference Include="..\..\src\WidgeDesk.Settings\WidgeDesk.Settings.csproj" />
    <ProjectReference Include="..\..\src\WidgeDesk.Launcher\WidgeDesk.Launcher.csproj" />
    <ProjectReference Include="../WidgeDesk.CompatibilityProbe/WidgeDesk.CompatibilityProbe.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/WidgeDesk.App/WidgeDesk.App.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
