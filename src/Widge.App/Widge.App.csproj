<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Application host: the only executable this product ships.

    Owns single-instance arbitration, the tray icon, the data directory and the lifetime of
    the Dock, launchpad and settings windows. Every other project is a library.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>Widge.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <AssemblyName>Widge</AssemblyName>
    <StartupObject>Widge.App.Program</StartupObject>
    <ApplicationIcon>Assets\Widge.ico</ApplicationIcon>

    <!-- 显示在文件属性对话框里，也用于外壳展示可执行文件。 -->
    <AssemblyTitle>Widge</AssemblyTitle>
    <Description>Windows 桌面美化套件：玻璃程序坞、启动台与统一设置中心</Description>

    <!--
      清单里声明了 PerMonitorV2。这不是可选项：缺少它时进程是系统感知，
      GetDpiForMonitor 会对所有显示器返回系统 DPI，按屏 DPI 查询全部失真。
      详见 app.manifest 中的说明。
    -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Widge.AppServices\Widge.AppServices.csproj" />
    <ProjectReference Include="..\Widge.Core\Widge.Core.csproj" />
    <ProjectReference Include="..\Widge.Platform\Widge.Platform.csproj" />
    <ProjectReference Include="..\Widge.UI\Widge.UI.csproj" />
    <ProjectReference Include="..\Widge.Dock\Widge.Dock.csproj" />
    <ProjectReference Include="..\Widge.Launcher\Widge.Launcher.csproj" />
    <ProjectReference Include="..\Widge.Settings\Widge.Settings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets/WidgeBrand.png" />
    <Content Include="../../LICENSE" Link="LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../NOTICE" Link="NOTICE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets/Widge.ico" Link="Widge.ico"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../packaging/update-source.json" Link="update-source.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/third-party/android-liquid-glass/LICENSE"
             Link="licenses/AndroidLiquidGlass-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/third-party/android-liquid-glass/NOTICE.md"
             Link="licenses/AndroidLiquidGlass-NOTICE.md"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
