<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dock bar. Phase 1 ships the window shell only; the icon bar, magnification and pinning
    arrive in phase 4. The AppServices reference is how the dock reaches the shared
    application library (through AppServiceHost) — it must never reference Widge.App.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>Widge.Dock</RootNamespace>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Widge.AppServices\Widge.AppServices.csproj" />
    <ProjectReference Include="..\Widge.Core\Widge.Core.csproj" />
    <ProjectReference Include="..\Widge.UI\Widge.UI.csproj" />
  </ItemGroup>

</Project>