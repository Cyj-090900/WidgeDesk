<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Launchpad. Phase 1 ships the window shell only; the grid, paging, search and grouping
    arrive in phase 5.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>WidgeDesk.Launcher</RootNamespace>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WidgeDesk.Core\WidgeDesk.Core.csproj" />
    <ProjectReference Include="..\WidgeDesk.UI\WidgeDesk.UI.csproj" />
    <ProjectReference Include="..\WidgeDesk.AppServices\WidgeDesk.AppServices.csproj" />
  </ItemGroup>

</Project>
