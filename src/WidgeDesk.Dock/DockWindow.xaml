<controls:GlassWindow
    x:Class="WidgeDesk.Dock.DockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WidgeDesk.UI.Controls;assembly=WidgeDesk.UI"
    Title="WidgeDesk Dock"
    AutomationProperties.Name="WidgeDesk 程序坞"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="Manual"
    Topmost="True"
    AllowDrop="True"
    Drop="OnExternalDrop"
    DragOver="OnExternalDragOver">

  <controls:GlassWindow.Resources>
    <Style x:Key="DockEntryButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </controls:GlassWindow.Resources>

  <!--
    图标行是真实的应用磁贴（D-07/D-08）。磁贴条（放大、滚动、命中）由
    DockTileStrip 承担；这里的宿主只负责把它嵌进玻璃面板。
  -->
  <Border
      Background="Transparent"
      BorderThickness="0"
      SnapsToDevicePixels="True">

    <Grid ClipToBounds="True">
      <!-- Glass remains in screen coordinates; the live shared silhouette slides over it. -->
      <controls:LiquidGlassSurface x:Name="GlassSurface" />
      <Grid x:Name="DockVisualRoot" ClipToBounds="True" RenderTransformOrigin="0,0">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="DockSlideTransform" />
        </Grid.RenderTransform>
        <StackPanel x:Name="DockContentLayer" Orientation="Vertical" Margin="10,8">

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="LauncherButton" Width="48" Height="64" Margin="0,0,8,0" Padding="0"
                Style="{StaticResource DockEntryButton}"
                Background="Transparent" BorderThickness="0"
                ToolTip="启动台" AutomationProperties.Name="打开启动台"
                MouseEnter="OnEntryMouseEnter" MouseLeave="OnEntryMouseLeave"
                Click="OnLauncherButtonClick">
          <controls:PhoneBorder x:Name="LaunchpadTile" Width="48" Height="48" CornerRadius="16"
                     Background="Transparent" BorderThickness="0">
            <controls:LaunchpadGlyph OutlineBrush="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
          </controls:PhoneBorder>
        </Button>
        <Button x:Name="ThisPcButton" Width="48" Height="64" Margin="0,0,8,0" Padding="0"
                Style="{StaticResource DockEntryButton}"
                Background="Transparent" BorderThickness="0"
                ToolTip="此电脑" AutomationProperties.Name="打开此电脑"
                MouseEnter="OnEntryMouseEnter" MouseLeave="OnEntryMouseLeave"
                Click="OnThisPcButtonClick">
          <Viewbox x:Name="ThisPcTile" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
              <Path Data="M6,6 H42 Q45,6 45,9 V29 Q45,32 42,32 H6 Q3,32 3,29 V9 Q3,6 6,6 Z M24,32 V39 M15,40 H33"
                    Fill="Transparent"
                    Stroke="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                    StrokeThickness="3.5" StrokeLineJoin="Round"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
          </Viewbox>
        </Button>
        <Button x:Name="DesktopIconsButton" Width="48" Height="64" Margin="0,0,8,0" Padding="0"
                Style="{StaticResource DockEntryButton}"
                ToolTip="切换桌面图标显示" AutomationProperties.Name="切换桌面图标显示"
                MouseEnter="OnEntryMouseEnter" MouseLeave="OnEntryMouseLeave"
                Click="OnDesktopIconsButtonClick">
          <Viewbox x:Name="DesktopIconsTile" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
              <Path Data="M6,6 H42 Q45,6 45,9 V29 Q45,32 42,32 H6 Q3,32 3,29 V9 Q3,6 6,6 Z M24,32 V39 M15,40 H33"
                    Fill="Transparent"
                    Stroke="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                    StrokeThickness="3.5" StrokeLineJoin="Round"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              <Path Data="M11,12 H15 V16 H11 Z M11,22 H15 V26 H11 Z M23,15 H37 M32,10 L37,15 L32,20 M37,24 H23 M28,19 L23,24 L28,29"
                    Fill="Transparent"
                    Stroke="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                    StrokeThickness="3.5" StrokeLineJoin="Round"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
          </Viewbox>
        </Button>
        <Button x:Name="SettingsButton" Width="48" Height="64" Margin="0,0,8,0" Padding="0"
                Style="{StaticResource DockEntryButton}"
                ToolTip="WidgeDesk 设置" AutomationProperties.Name="打开 WidgeDesk 设置"
                MouseEnter="OnEntryMouseEnter" MouseLeave="OnEntryMouseLeave"
                Click="OnSettingsButtonClick">
          <Viewbox x:Name="SettingsTile" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="24" Height="24">
              <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                    Fill="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </Canvas>
          </Viewbox>
        </Button>
        <ContentControl x:Name="TileStripHost"
                        AutomationProperties.Name="固定的应用"
                        Focusable="False" />
      </StackPanel>

      <TextBlock
          x:Name="StatusText"
          Margin="2,8,2,0"
          HorizontalAlignment="Center"
          FontSize="11"
          Visibility="Collapsed"
          Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />

        </StackPanel>
      </Grid>
    </Grid>
  </Border>

</controls:GlassWindow>
