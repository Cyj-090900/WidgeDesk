<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Approved generated artwork shared by window and notification-area icons. -->
  <DrawingImage x:Key="WidgeDeskBrandMark">
    <DrawingImage.Drawing>
      <ImageDrawing Rect="0,0,256,256">
        <ImageDrawing.ImageSource>
          <BitmapImage UriSource="pack://application:,,,/WidgeDesk;component/Assets/WidgeDeskBrand.png" CacheOption="OnLoad" />
        </ImageDrawing.ImageSource>
      </ImageDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>
