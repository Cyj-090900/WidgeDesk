<Project>

  <!--
    Common build settings for every project in the Widge solution.

    Target framework rules:
      * src/Widge.Core            -> net10.0          (no UI, no Windows APIs, unit-testable)
      * src/Widge.System          -> net10.0-windows  (Win32 interop)
      * everything else under src/    -> net10.0-windows  (WPF)
      * src/Widge.App             -> WinExe, the only executable we ship
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Product>Widge</Product>
    <Company>Widge</Company>
    <!-- Product updates use this version; retain the delivered assembly identity. -->
    <Version>3.0.0</Version>
    <AssemblyVersion>0.2.2.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <NeutralLanguage>zh-Hans</NeutralLanguage>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>

    <!--
      Do not opt this process image into hardware-enforced stack protection (CET).

      .NET 8.0.100+ marks the generated apphost with IMAGE_DLLCHARACTERISTICS_EX_CET_COMPAT
      by default. On a Windows 10 install whose ntdll predates the 2023 CET kernel fixes,
      coreclr fail-fasts during startup before any managed code runs:

        "Your Windows doesn't fully support CET. Please install all available Windows updates."

      That is not a code defect and it cannot be caught or handled in-process: the check runs
      inside Thread::StaticInitialize, and the CET state is fixed when the .exe starts, so it
      cannot be turned off later from managed code. On Windows 10 22H2 the fix first shipped
      in KB5044273 (ntdll 10.0.19041.5007); anything older crashes purely because of the CET
      marking. Setting CETCompat=false removes the marking so the same binary runs everywhere.

      Trade-off, stated plainly: on machines that do support CET we give up that hardening for
      this process. For a desktop decoration app that is an acceptable price for "it starts at
      all on Windows 10", but it is a deliberate choice rather than the SDK default.

      The dotnet.exe host is unaffected either way: it is not CET-marked, which is exactly why
      `dotnet run` works on these machines while a published .exe does not.
    -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>

</Project>
